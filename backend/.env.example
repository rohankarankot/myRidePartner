# Supabase DB
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_IDS=google-client-id-1,google-client-id-2
SENTRY_DSN=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Backoffice bootstrap
BACKOFFICE_ADMIN_EMAIL=admin@myridepartner.com
BACKOFFICE_ADMIN_PASSWORD=change-me

# Local service hosts
API_GATEWAY_HOST=localhost
API_GATEWAY_TCP_PORT=4000
AUTH_SERVICE_HOST=localhost
USER_SERVICE_HOST=localhost
TRIP_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_HOST=localhost
CHAT_SERVICE_HOST=localhost

# Runtime
PORT=3000
NODE_ENV=development
EMAIL_USER=yourname@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
